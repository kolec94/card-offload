require "shellwords"

default_platform(:ios)

PROJECT = "CardOffload.xcodeproj"
SCHEME  = "CardOffload"
DEFAULT_BUNDLE_ID = "io.github.kolec94.cardoffload"

# API-key auth means no Apple ID password, no 2FA prompt, and nothing interactive -
# which is what makes this work on a runner with no Mac behind it.
def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV.fetch("ASC_KEY_ID"),
    issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
    key_content:           ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

def resolved_bundle_id
  ENV["BUNDLE_ID"].to_s.empty? ? DEFAULT_BUNDLE_ID : ENV["BUNDLE_ID"]
end

platform :ios do
  desc "One-time: register the bundle ID and create the App Store Connect record"
  lane :setup_app do
    api_key = asc_api_key
    bundle_id = resolved_bundle_id

    # Idempotent: produce reports "already exists" and moves on, so re-running
    # this after the app record exists is harmless.
    create_app_online(
      api_key:        api_key,
      app_identifier: bundle_id,
      app_name:       "Card Offload",
      language:       "English (U.K.)",
      sku:            bundle_id,
      team_id:        ENV.fetch("APPLE_TEAM_ID")
    )
  end

  desc "Build a signed Release build and push it to TestFlight"
  lane :beta do
    api_key   = asc_api_key
    team_id   = ENV.fetch("APPLE_TEAM_ID")
    bundle_id = resolved_bundle_id

    # Throwaway keychain for the signing certificate to live in. No-op off CI.
    setup_ci

    get_certificates(api_key: api_key, team_id: team_id)
    get_provisioning_profile(
      api_key:        api_key,
      team_id:        team_id,
      app_identifier: bundle_id,
      force:          true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # App Store Connect refuses a build number it has already seen, and the run
    # number only ever goes up.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

    build_app(
      project:       PROJECT,
      scheme:        SCHEME,
      configuration: "Release",
      export_method: "app-store",
      # The project is set to automatic signing for local Xcode use; override to
      # the profile sigh just fetched so the runner does not need an Xcode account.
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "CODE_SIGN_STYLE=Manual",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile_name.to_s.shellescape}"
      ].join(" "),
      export_options: {
        provisioningProfiles: { bundle_id => profile_name }
      }
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      # Internal testers need no review at all. Turn this on only once an
      # external group exists - external testing does get a (light) review.
      distribute_external:               false
    )
  end
end
